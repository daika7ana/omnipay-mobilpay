{
    "name": "daika7ana/omnipay-mobilpay",
    "description": "MobilPay driver for the Omnipay PHP payment processing library",
    "keywords": [
        "mobilpay",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment",
        "purchase"
    ],
    "homepage": "https://github.com/daika7ana/omnipay-mobilpay",
    "license": "MIT",
    "authors": [
        {
            "name": "Tudor Galanopulos",
            "email": "tudor@tudorg.ro"
        }
    ],
    "require": {
        "php": "^8.2",
        "omnipay/common": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Omnipay\\MobilPay\\": "src/BusinessMastery/Mobilpay"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\MobilPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
